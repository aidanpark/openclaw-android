#!/usr/bin/env bash
# Pre-commit hook: runs code quality checks on staged files
# Enable with: git config core.hooksPath .githooks

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"
ANDROID_DIR="$ROOT_DIR/android"

# --- Kotlin checks (ktlint + detekt) ---

STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kts?$' || true)

if [ -n "$STAGED_KT" ]; then
    echo "Running ktlint check..."
    if ! (cd "$ANDROID_DIR" && ./gradlew ktlintCheck --daemon -q 2>/dev/null); then
        echo ""
        echo "ktlint check failed. Run './gradlew ktlintFormat' to auto-fix."
        exit 1
    fi

    echo "Running detekt..."
    if ! (cd "$ANDROID_DIR" && ./gradlew detekt --daemon -q 2>/dev/null); then
        echo ""
        echo "detekt check failed. Fix the issues above before committing."
        exit 1
    fi
fi

# --- Shell script checks (shellcheck) ---

STAGED_SH=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)

if [ -n "$STAGED_SH" ]; then
    if command -v shellcheck >/dev/null 2>&1; then
        echo "Running shellcheck..."
        FAILED=0
        for file in $STAGED_SH; do
            # Skip build artifacts
            case "$file" in
                android/app/build/*) continue ;;
            esac
            if [ -f "$ROOT_DIR/$file" ]; then
                # severity=warning — verify 스킬·CI·PostToolUse 훅과 같은 기준(info/style 제외)
                if ! shellcheck -S warning "$ROOT_DIR/$file"; then
                    FAILED=1
                fi
            fi
        done
        if [ "$FAILED" -eq 1 ]; then
            echo ""
            echo "shellcheck failed. Fix the issues above before committing."
            exit 1
        fi
    else
        echo "Warning: shellcheck not installed. Skipping shell script lint."
        echo "Install with: sudo apt-get install shellcheck"
    fi
fi

# --- Markdown lint ---

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)

if [ -n "$STAGED_MD" ]; then
    if command -v markdownlint-cli2 >/dev/null 2>&1; then
        echo "Running markdownlint..."
        if ! markdownlint-cli2 $STAGED_MD 2>&1; then
            echo ""
            echo "markdownlint failed. Fix the issues above before committing."
            exit 1
        fi
    else
        echo "Warning: markdownlint-cli2 not installed. Skipping markdown lint."
    fi
fi

# --- WebView/React lint (www/) ---

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'android/www/.*\.(ts|tsx)$' || true)

if [ -n "$STAGED_TS" ]; then
    if [ -f "$ANDROID_DIR/www/node_modules/.bin/eslint" ]; then
        echo "Running ESLint on www/..."
        STAGED_TS_REL=$(echo "$STAGED_TS" | sed 's|^android/www/||')
        if ! (cd "$ANDROID_DIR/www" && npx eslint $STAGED_TS_REL 2>&1); then
            echo ""
            echo "ESLint failed. Fix the issues above before committing."
            exit 1
        fi
    else
        echo "Warning: www/node_modules not found. Run 'cd android/www && npm install'."
    fi
fi

# --- Script ↔ app asset sync check (pairs must be byte-identical) ---

STAGED_ALL=$(git diff --cached --name-only)

for pair in \
    "post-setup.sh:android/app/src/main/assets/post-setup.sh" \
    "patches/glibc-compat.js:android/app/src/main/assets/glibc-compat.js"; do
    SRC="${pair%%:*}"
    DST="${pair##*:}"
    if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$SRC" -e "$DST"; then
        # 스테이징된 내용(index blob)끼리 비교한다 — 부분 스테이징도 잡는다
        SRC_BLOB=$(git rev-parse -q --verify ":$SRC" 2>/dev/null || true)
        DST_BLOB=$(git rev-parse -q --verify ":$DST" 2>/dev/null || true)
        if [ -n "$SRC_BLOB" ] && [ -n "$DST_BLOB" ] && [ "$SRC_BLOB" != "$DST_BLOB" ]; then
            echo ""
            echo "ERROR: sync mismatch!"
            echo "  Source: $SRC"
            echo "  App:    $DST"
            echo ""
            echo "Both files must have identical content."
            echo "Copy one to the other and stage both before committing."
            exit 1
        fi
    fi
done

# --- OA_VERSION sync check (4 files) ---

VERSION_FILES="scripts/lib.sh install-tools.sh update-core.sh oa.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxE 'scripts/lib\.sh|install-tools\.sh|update-core\.sh|oa\.sh'; then
    FIRST_VER=""
    for f in $VERSION_FILES; do
        VER=$(git show ":$f" 2>/dev/null | grep -m1 'OA_VERSION="[^"]*"' | sed -E 's/.*OA_VERSION="([^"]*)".*/\1/')
        [ -n "$VER" ] || continue
        if [ -z "$FIRST_VER" ]; then
            FIRST_VER="$VER"
        elif [ "$VER" != "$FIRST_VER" ]; then
            echo ""
            echo "ERROR: OA_VERSION mismatch ($f: $VER vs $FIRST_VER)."
            echo "  Sync OA_VERSION in: $VERSION_FILES"
            exit 1
        fi
    done
fi

# --- Version pin pair: config.env (SSOT) == post-setup.sh embedded pins ---
# post-setup.sh does not read the remote config.env, so its embedded pins must match.

PIN_SSOT="platforms/openclaw/config.env"
PIN_COPY="post-setup.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$PIN_SSOT" -e "$PIN_COPY"; then
    for key in PLATFORM_NODE_VERSION PLATFORM_NPM_PACKAGE_VERSION; do
        # Skip while the SSOT has no pin block yet (pin pair introduced in M0).
        git show ":$PIN_SSOT" 2>/dev/null | grep -q "^$key=" || continue
        SSOT_VAL=$(git show ":$PIN_SSOT" 2>/dev/null | grep -m1 "^$key=" | cut -d'"' -f2)
        COPY_VAL=$(git show ":$PIN_COPY" 2>/dev/null | grep -m1 "^$key=" | cut -d'"' -f2)
        if ! printf '%s' "$SSOT_VAL" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' \
            || [ "$SSOT_VAL" != "$COPY_VAL" ]; then
            echo ""
            echo "ERROR: version pin mismatch for $key"
            echo "  $PIN_SSOT: ${SSOT_VAL:-<missing>}"
            echo "  $PIN_COPY: ${COPY_VAL:-<missing>}"
            echo "  Both must be the same literal X.Y.Z (line-start, double quotes)."
            exit 1
        fi
    done
fi

# --- openclaw update guard: shim generator == copy embedded in post-setup.sh ---

SHIM_SRC="platforms/openclaw/openclaw-shim.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$SHIM_SRC" -e "$PIN_COPY"; then
    EMBEDDED=$(git show ":$PIN_COPY" 2>/dev/null \
        | awk "/<< 'OPENCLAW_SHIM_SH'/{f=1;next} /^OPENCLAW_SHIM_SH\$/{f=0} f")
    if [ -n "$EMBEDDED" ] && ! git cat-file -e ":$SHIM_SRC" 2>/dev/null; then
        # install.sh / update.sh run the generator under set -e — missing file = broken update
        echo ""
        echo "ERROR: $PIN_COPY embeds the openclaw guard but $SHIM_SRC is not in the commit."
        echo "  git add $SHIM_SRC (mode 100755)"
        exit 1
    fi
    if git cat-file -e ":$SHIM_SRC" 2>/dev/null; then
        if [ "$EMBEDDED" != "$(git show ":$SHIM_SRC" 2>/dev/null)" ]; then
            echo ""
            echo "ERROR: openclaw guard mismatch"
            echo "  $SHIM_SRC and the OPENCLAW_SHIM_SH heredoc in $PIN_COPY must be identical."
            exit 1
        fi
    fi
fi

# --- hard-link patch: platforms script == copy embedded in post-setup.sh ---
# (OpenClaw is patched on every path; post-setup.sh is a single file, so it carries a copy.)

HL_SRC="platforms/openclaw/patches/openclaw-patch-hardlink.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$HL_SRC" -e "$PIN_COPY"; then
    HL_EMBEDDED=$(git show ":$PIN_COPY" 2>/dev/null \
        | awk "/<< 'OPENCLAW_HARDLINK_SH'/{f=1;next} /^OPENCLAW_HARDLINK_SH\$/{f=0} f")
    if git cat-file -e ":$HL_SRC" 2>/dev/null; then
        if [ "$HL_EMBEDDED" != "$(git show ":$HL_SRC" 2>/dev/null)" ]; then
            echo ""
            echo "ERROR: hard-link patch mismatch"
            echo "  $HL_SRC and the OPENCLAW_HARDLINK_SH heredoc in $PIN_COPY must be identical."
            exit 1
        fi
    elif [ -n "$HL_EMBEDDED" ]; then
        echo ""
        echo "ERROR: $PIN_COPY embeds the hard-link patch but $HL_SRC is not in the commit."
        echo "  git add $HL_SRC (mode 100755)"
        exit 1
    fi
fi

# --- npm guard function: install-nodejs.sh == post-setup.sh (same function, two generators) ---

GUARD_A="scripts/install-nodejs.sh"
GUARD_B="post-setup.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$GUARD_A" -e "$GUARD_B"; then
    guard_fn() {
        git show ":$1" 2>/dev/null \
            | awk '/^oa_inject_npm_guard\(\) \{/{f=1} f{print} f&&/^NPMGUARD$/{e=1} f&&e&&/^}$/{exit}'
    }
    GA=$(guard_fn "$GUARD_A")
    GB=$(guard_fn "$GUARD_B")
    if [ -n "$GA$GB" ] && [ "$GA" != "$GB" ]; then
        echo ""
        echo "ERROR: npm guard mismatch"
        echo "  oa_inject_npm_guard() in $GUARD_A and $GUARD_B must be identical."
        exit 1
    fi
fi

# --- git wrapper functions: post-setup.sh == scripts/repair-app-git.sh (same text, two copies) ---

GW_A="post-setup.sh"
GW_B="scripts/repair-app-git.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$GW_A" -e "$GW_B"; then
    gw_block() {
        git show ":$1" 2>/dev/null \
            | awk '/^# ─── git wrapper functions/{f=1} f{print} /^# ─── end git wrapper functions/{exit}'
    }
    GWA=$(gw_block "$GW_A")
    GWB=$(gw_block "$GW_B")
    if [ -n "$GWA$GWB" ] && [ "$GWA" != "$GWB" ]; then
        echo ""
        echo "ERROR: git wrapper block mismatch"
        echo "  The block between '# ─── git wrapper functions' and '# ─── end git wrapper functions'"
        echo "  in $GW_A and $GW_B must be identical."
        exit 1
    fi
fi

# --- node wrapper heredoc: install-nodejs.sh == post-setup.sh (same text, two generators) ---

NW_A="scripts/install-nodejs.sh"
NW_B="post-setup.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$NW_A" -e "$NW_B"; then
    nw_body() {
        git show ":$1" 2>/dev/null | awk '
            /^[[:space:]]*# ─── node wrapper ───$/      {m=1; next}
            /^[[:space:]]*# ─── end node wrapper ───$/  {m=0}
            m && /<< WRAPPER$/                            {h=1; next}
            m && h && /^WRAPPER$/                         {h=0; next}
            m && h                                        {print}'
    }
    nw_has_end() {
        git show ":$1" 2>/dev/null | grep -qE '^[[:space:]]*# ─── end node wrapper ───$'
    }
    NA=$(nw_body "$NW_A")
    NB=$(nw_body "$NW_B")
    if [ -z "$NA" ] || [ -z "$NB" ] || [ "$NA" != "$NB" ] || ! nw_has_end "$NW_A" || ! nw_has_end "$NW_B"; then
        echo ""
        echo "ERROR: node wrapper mismatch"
        echo "  The node wrapper heredoc between the '# ─── node wrapper ───' and"
        echo "  '# ─── end node wrapper ───' markers in $NW_A and $NW_B must be identical and non-empty."
        exit 1
    fi
fi

# --- run lock block: post-setup.sh == update-core.sh (the one lock of setup, update and tools runs) ---

RL_A="post-setup.sh"
RL_B="update-core.sh"
if printf '%s\n' "$STAGED_ALL" | grep -qxF -e "$RL_A" -e "$RL_B"; then
    rl_body() {
        git show ":$1" 2>/dev/null | awk '
            /^# ─── run lock ───$/      {m=1; next}
            /^# ─── end run lock ───$/  {m=0}
            m                            {print}'
    }
    rl_has_end() {
        git show ":$1" 2>/dev/null | grep -qE '^# ─── end run lock ───$'
    }
    RA=$(rl_body "$RL_A")
    RB=$(rl_body "$RL_B")
    if [ -z "$RA" ] || [ -z "$RB" ] || [ "$RA" != "$RB" ] || ! rl_has_end "$RL_A" || ! rl_has_end "$RL_B"; then
        echo ""
        echo "ERROR: run lock block mismatch"
        echo "  The lock functions between the '# ─── run lock ───' and '# ─── end run lock ───'"
        echo "  markers in $RL_A and $RL_B must be identical and non-empty (they share one lock:"
        echo "  \$OCA_DIR/.tools.lock for the full setup, 'oa --update' and --tools-only)."
        exit 1
    fi
fi

echo "All checks passed."
